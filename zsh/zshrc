#### ~/.zshrc (clean, fast, no OMZ/spaceship) ####

# ---- profiling (enable only when needed) ----
# Run: ZSH_PROFILE=1 zsh
if [[ -n "${ZSH_PROFILE:-}" ]]; then
  zmodload zsh/zprof
fi

# ---- history ----
HISTFILE=$HOME/.histfile
HISTSIZE=50000
SAVEHIST=1000000
setopt hist_ignore_dups share_history

# ---- shell behavior ----
setopt autocd extendedglob
unsetopt beep
bindkey -v

# ---- completion: fpath + compinit cache ----
# Keep your custom completions dir
fpath=($HOME/.zsh/completions $fpath)

# Alpine package zsh-completions installs here (harmless if missing)
fpath=(/usr/share/zsh/site-functions $fpath)

autoload -Uz compinit

# Cache compdump (fast). -C uses compiled dump. Avoid -i unless you want to skip permission audit.
ZSH_CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/zsh
mkdir -p "$ZSH_CACHE_DIR"
compinit -C -d "$ZSH_CACHE_DIR/zcompdump"

# Nice interactive menu selection even without fzf-tab
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*:descriptions' format '%F{244}%d%f'
zstyle ':completion:*:messages' format '%F{244}%d%f'
zstyle ':completion:*:warnings' format '%F{160}no matches%f'
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR"

# ---- prompt (clean blue bold, ⚡, git-aware) ----
setopt prompt_subst
autoload -Uz colors vcs_info add-zsh-hook
colors

# vcs_info config (git only)
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' formats ' %B%F{blue}%b%f%b%u%c'
zstyle ':vcs_info:git:*' actionformats ' %B%F{blue}%b|%a%f%b%u%c'
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' stagedstr '%F{green}+%f'
zstyle ':vcs_info:*' unstagedstr '%F{red}*%f'
add-zsh-hook precmd vcs_info

# Bold blue user@host and path
PROMPT='%B%F{blue}%n@%m%f%b:%B%F{blue}%~%f%b${vcs_info_msg_0_} %B%F{yellow}⚡%f%b'

# Exit code on right if non-zero
RPROMPT='%(?..%F{red}[%?]%f)'

# ---- fzf + fzf-tab (ONLY plugin you asked for) ----
# fzf keybindings provided by package
if [ -r /usr/share/fzf/key-bindings.zsh ]; then
  source /usr/share/fzf/key-bindings.zsh
fi

# fzf-tab plugin (you need to git clone it somewhere)
# Suggested path: ~/.zsh/plugins/fzf-tab
FZF_TAB_DIR=$HOME/.zsh/plugins/fzf-tab
if [ -r "$FZF_TAB_DIR/fzf-tab.plugin.zsh" ]; then
  source "$FZF_TAB_DIR/fzf-tab.plugin.zsh"

  # Some sensible defaults; keeps it snappy
  zstyle ':fzf-tab:*' switch-group ',' '.'
  zstyle ':fzf-tab:*' fzf-command fzf
  # Optional: small preview (disable if you want maximum speed)
  # zstyle ':fzf-tab:complete:*' fzf-preview 'echo {}'
fi

# Your fzf opts (kept)
export FZF_DEFAULT_OPTS='
  --height 75% --multi --reverse
  --bind ctrl-f:page-down,ctrl-b:page-up,ctrl-a:select-all,ctrl-d:deselect-all,ctrl-t:toggle-all
'
export FZF_ALT_C_COMMAND='fd --type d .'

# ---- lesspipe ----
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# ---- your personal config (kept) ----
source ~/.config/perso/zsh/zsh_vars
source ~/.config/perso/zsh/zsh_paths

if [ -f ~/.config/perso/zsh/zsh_aliases ]; then
  source ~/.config/perso/zsh/zsh_aliases
fi

if [ -f ~/.config/perso/zsh/zsh_funcs ]; then
  source ~/.config/perso/zsh/zsh_funcs
fi

# ---- editor ----
export EDITOR='vim'

# ---- PATH / env (kept, de-duplicated-ish) ----
export PATH="$PATH:$HOME/.local/bin:$HOME/.config/perso/tools/bin"
export PATH="$HOME/apps/tools:$PATH"

# GPG
export GPG_TTY="$(tty)"

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME:$PATH"

# go
export GOPATH="$HOME/apps/environments/go"
export PATH="$GOPATH/bin:$PATH"

export PASSWORD_STORE_ENABLE_EXTENSIONS=true
export MANPAGER="bat -l man --theme Nord"

# ---- profiling output (only when enabled) ----
if [[ -n "${ZSH_PROFILE:-}" ]]; then
  zprof
fi
