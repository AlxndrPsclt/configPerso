#!/bin/sh
# mpvctl - minimal mpv JSON IPC controller (POSIX sh / Alpine ash)

set -eu

SOCKET_DEFAULT="/tmp/mpvsocket"
SOCKET_PATH="${MPV_SOCKET:-$SOCKET_DEFAULT}"

QUIET=0
DATA_ONLY=0

die() {
  msg=$1
  [ "$QUIET" -eq 1 ] || printf 'mpvctl: %s\n' "$msg" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: ${0##*/} [--socket PATH] [--data] [-q] <cmd> [args...]

Options:
  --socket PATH   mpv IPC socket path (default: \$MPV_SOCKET or $SOCKET_DEFAULT)
  --data          print only the "data" field (best-effort; no jq)
  -q              quiet errors (still uses exit codes)
  -h, --help      help

Core:
  pp|toggle               toggle pause
  play                    pause=false
  pause                   pause=true
  stop                    stop playback
  next|prev               playlist-next / playlist-prev
  clear                   playlist-clear
  load <file>             loadfile replace
  append <file>           loadfile append-play (alias: add)
  seek <sec>              seek relative seconds (+5 / -10 / 30)

Speed:
  speed                   get current speed
  speed-set <float>       set speed
  speed-add <delta>       add delta to speed (e.g. 0.1 or -0.1)

Getters:
  get <prop>              get_property <prop>
  title|current           get_property media-title
  file                    get_property path
  time-pos                get_property time-pos
  duration                get_property duration
  time-remaining          get_property time-remaining
EOF
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

# --- args ---
CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    --socket) [ $# -ge 2 ] || die "--socket needs a path"; SOCKET_PATH=$2; shift 2;;
    --data) DATA_ONLY=1; shift;;
    -q) QUIET=1; shift;;
    -h|--help) usage; exit 0;;
    --) shift; break;;
    -*) die "unknown option: $1";;
    *) CMD=$1; shift; break;;
  esac
done
[ -n "$CMD" ] || { usage >&2; exit 1; }

need_cmd socat

check_socket() {
  [ -S "$SOCKET_PATH" ] || die "socket not available: $SOCKET_PATH"
}

send_json() {
  json=$1
  check_socket
  # Use UNIX-CONNECT explicitly (more portable across socat builds)
  resp=$(printf '%s\n' "$json" | socat - "UNIX-CONNECT:$SOCKET_PATH" 2>/dev/null) || die "IPC failed"
  if [ "$DATA_ONLY" -eq 1 ]; then
    # Best-effort extraction of .data without jq:
    # - numbers/bools/null are unquoted
    # - strings are quoted (we unquote)
    # This is not a general JSON parser, but works for common mpv replies.
    printf '%s\n' "$resp" | sed -n \
      -e 's/.*"data":[[:space:]]*"\([^"]*\)".*/\1/p' \
      -e 's/.*"data":[[:space:]]*\([^,}]*\).*/\1/p' \
      | head -n1
  else
    printf '%s\n' "$resp"
  fi
}

json_escape() { printf '%s' "$1" | tr -d '\r' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

realpath_safe() {
  if command -v realpath >/dev/null 2>&1; then
    realpath -- "$1"
  else
    case "$1" in
      /*) printf '%s\n' "$1" ;;
      *)  printf '%s/%s\n' "$(pwd -P)" "$1" ;;
    esac
  fi
}

cmd_get() { prop=$1; send_json "{ \"command\": [\"get_property\", \"$(json_escape "$prop")\"] }"; }
cmd_set() { prop=$1; val=$2; send_json "{ \"command\": [\"set_property\", \"$(json_escape "$prop")\", $val] }" >/dev/null; }
cmd_add() { prop=$1; val=$2; send_json "{ \"command\": [\"add\", \"$(json_escape "$prop")\", $val] }" >/dev/null; }  # :contentReference[oaicite:2]{index=2}

cmd_loadfile() {
  file=$1 mode=$2
  rp=$(realpath_safe "$file")
  esc=$(json_escape "$rp")
  send_json "{ \"command\": [\"loadfile\", \"$esc\", \"$mode\"] }" >/dev/null
}

case "$CMD" in
  pp|toggle) send_json '{ "command": ["cycle", "pause"] }' >/dev/null;;
  play)  cmd_set pause false;;
  pause) cmd_set pause true;;
  stop)  send_json '{ "command": ["stop"] }' >/dev/null;;
  next)  send_json '{ "command": ["playlist-next"] }' >/dev/null;;
  prev)  send_json '{ "command": ["playlist-prev"] }' >/dev/null;;
  clear) send_json '{ "command": ["playlist-clear"] }' >/dev/null;;

  load)   [ $# -ge 1 ] || die "load needs a file";   cmd_loadfile "$1" replace;;
  append|add) [ $# -ge 1 ] || die "append needs a file"; cmd_loadfile "$1" append-play;;

  seek)
    [ $# -ge 1 ] || die "seek needs seconds (e.g. +5, -10, 30)"
    s=$1
    case "$s" in +*) s=${s#+};; esac  # JSON numbers can't start with '+'.
    case "$s" in -|""|*[!0-9.-]*|*.*.*|--*|*-*-) die "invalid seek value: $1";; esac
    send_json "{ \"command\": [\"seek\", $s, \"relative\"] }" >/dev/null
    ;;

  # speed
  speed) cmd_get speed;;
  speed-set)
    [ $# -ge 1 ] || die "speed-set needs a float"
    v=$1
    case "$v" in -|""|*[!0-9.-]*|*.*.*|--*|*-*-) die "invalid speed: $1";; esac
    cmd_set speed "$v"
    ;;
  speed-add)
    [ $# -ge 1 ] || die "speed-add needs a delta float (e.g. 0.1 or -0.1)"
    d=$1
    case "$d" in +*) d=${d#+};; esac
    case "$d" in -|""|*[!0-9.-]*|*.*.*|--*|*-*-) die "invalid delta: $1";; esac
    cmd_add speed "$d"
    ;;

  # getters
  get) [ $# -ge 1 ] || die "get needs a property name"; cmd_get "$1";;
  title|current) cmd_get media-title;;
  file) cmd_get path;;
  time-pos) cmd_get time-pos;;
  duration) cmd_get duration;;
  time-remaining) cmd_get time-remaining;;

  *) die "unknown command: $CMD (try --help)";;
esac
